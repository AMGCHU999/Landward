# "sandbox" (default, no real checks or charges) or "production" (billed Equifax/OneID checks)
CERTN_ENV=sandbox
# Centric API keys, one per environment: Client Portal > Integrations > API keys
CERTN_SANDBOX_API_KEY=
CERTN_PRODUCTION_API_KEY=
# Credit report template IDs (per account): GET /api/public/templates/credit-report/
# Optional; without one, orders fall back to a single Canadian credit report
CERTN_SANDBOX_CREDIT_TEMPLATE_ID=
CERTN_PRODUCTION_CREDIT_TEMPLATE_ID=
# Webhook signing keys, shown when you create each webhook in the Certn Client Portal
CERTN_SANDBOX_WEBHOOK_SECRET=
CERTN_PRODUCTION_WEBHOOK_SECRET=
TYPESAFE_API_KEY=
# CanLII API key for LTB/tribunal decision lookups (https://www.canlii.org/en/feedback/feedback.html).
# Free for non-commercial use; commercial use may need a separate arrangement.
CANLII_API_KEY=
# CanLII database ID for the Ontario Landlord and Tenant Board. Verify with the
# listCaseDatabases() endpoint if CanLII renames it.
CANLII_LTB_DATABASE_ID=onltb
